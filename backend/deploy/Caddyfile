# Replace api.example.com with your DNS name. Run Caddy on the host with
# the compose service bound to 127.0.0.1:8080. Caddy terminates HTTPS.
api.example.com {
    request_body {
        # 5 MiB proof upload; the API separately limits JSON to 2 MiB.
        max_size 5242880
    }
    reverse_proxy 127.0.0.1:8080
}
